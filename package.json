{
  "name": "prvtchatweb",
  "private": true,
  "version": "1.0.0",
  "description": "High-assurance ephemeral zero-knowledge end-to-end encrypted messaging web application.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --exclude src/lib/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run src/lib/firestore.rules.test.ts\"",
    "test:all": "firebase emulators:exec --only firestore \"vitest run\"",
    "relay": "node server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^13.0.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
