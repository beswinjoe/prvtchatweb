# =============================================================================
# PRVTCHAT FIREBASE CLIENT CONFIGURATION
# =============================================================================
# Provide your Firebase project credentials below.
# In production, these variables configure the live Firestore & Anonymous Auth connection.
# Note: Firebase client config is not a secret; security is strictly enforced
# by Firestore security rules, client-side encryption, and backend functions.
# =============================================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Local Development & Offline Multi-Tab Testing
# Set to 'true' to run an in-memory + BroadcastChannel multi-tab relay without live Firebase
VITE_USE_MOCK_RELAY=false
